{
	"entry": ["src/cli.ts", "src/**/*.test.ts"],
	"rules": {
		"unused-exports": "off",
		"unused-types": "off",
		"unused-class-members": "off"
	},
	"duplicates": {
		"threshold": 1000
	},
	"health": {
		"thresholdOverrides": [
			{
				"files": ["src/**"],
				"maxCyclomatic": 100,
				"maxCognitive": 100,
				"maxCrap": 10000,
				"reason": "Initial CLI migration; refactor deferred"
			}
		]
	}
}
