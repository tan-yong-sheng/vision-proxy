{
	"entry": ["src/cli.ts", "src/**/*.test.ts"],
	"rules": {
		"unused-exports": "off",
		"unused-types": "off",
		"unused-class-members": "off"
	},
	"duplicates": {
		"threshold": 1000
	},
	"ignoreExports": [
		{
			"file": "src/core.ts",
			"exports": [
				"ASSISTANT_TRUNCATE_CHARS",
				"CONTEXT_MAX_CHARS",
				"RECENT_MESSAGE_COUNT",
				"buildConversationContext"
			]
		},
		{
			"file": "src/hooks/runtime.ts",
			"exports": [
				"ASSISTANT_TRUNCATE_CHARS",
				"CONTEXT_MAX_CHARS",
				"RECENT_MESSAGE_COUNT",
				"buildConversationContext"
			]
		}
	],
	"health": {
		"thresholdOverrides": [
			{
				"files": ["src/**"],
				"maxCyclomatic": 100,
				"maxCognitive": 100,
				"maxCrap": 10000,
				"reason": "Initial CLI migration; refactor deferred"
			}
		]
	}
}
