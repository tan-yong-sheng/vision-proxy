{
  "name": "vision-proxy",
  "version": "0.1.0",
  "description": "Standalone CLI that routes images to a vision model and prints a fenced, UNTRUSTED description. Drives agent UserPromptSubmit hooks so any coding agent can get image context.",
  "keywords": [
    "vision",
    "image-description",
    "cli",
    "vercel-ai-sdk",
    "agent",
    "hook",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/vision-proxy.ts"
    ]
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "vision-proxy": "dist/cli.js",
    "vp": "dist/cli.js"
  },
  "files": [
    "dist",
    "extensions",
    "lib"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test src/**/*.test.ts extensions/__tests__/*.test.ts && node --test src/shims/*.e2e.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-shims.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.95",
    "@ai-sdk/openai": "^4.0.0",
    "ai": "^7.0.0",
    "image-size": "^2.0.2",
    "imagescript": "^1.3.1",
    "imghash": "^1.1.4",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typebox": "*",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.74.0",
    "@earendil-works/pi-coding-agent": ">=0.74.0",
    "typebox": "*"
  }
}
