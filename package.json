{
	"name": "vision-proxy",
	"version": "0.1.0",
	"description": "Standalone CLI that routes images to a vision model and prints a fenced, UNTRUSTED description. Drives agent UserPromptSubmit hooks so any coding agent can get image context.",
	"keywords": [
		"vision",
		"image-description",
		"cli",
		"vercel-ai-sdk",
		"agent",
		"hook",
		"pi-package"
	],
	"license": "MIT",
	"type": "module",
	"bin": {
		"vision-proxy": "dist/cli.js",
		"vp": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-strip-types --no-warnings --test src/*.test.ts src/**/*.test.ts",
		"build": "tsc -p tsconfig.build.json",
		"prepare": "npm run build",
		"lint": "biome check",
		"format": "biome check --write",
		"secrets": "betterleaks dir --no-banner .",
		"hooks:install": "lefthook install"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.0",
		"@ai-sdk/google": "^4.0.44",
		"@ai-sdk/openai": "^4.0.0",
		"ai": "^7.0.0",
		"image-size": "^2.0.2",
		"imagescript": "^1.3.1",
		"imghash": "^1.1.4",
		"zod": "^4.1.8"
	},
	"optionalDependencies": {
		"@napi-rs/keyring": "^1.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"fallow": "^3.10.0",
		"@types/node": "^26.1.1",
		"lefthook": "^2.1.10",
		"typescript": "^5.9.0"
	}
}
