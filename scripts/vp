#!/bin/sh
# Launcher for the vision-proxy CLI shipped in the release tarball.
# Runs the compiled ES-module entry point (dist/cli.js) under the system node.
#
# Resolves symlinks so the tarball can be installed via a ~/.local/bin/vp
# symlink and still find dist/cli.js next to the real launcher.
script_path=$0
while [ -L "$script_path" ]; do
	link_dir=$(dirname "$script_path")
	link_target=$(readlink "$script_path")
	case "$link_target" in
		/*) script_path=$link_target ;;
		*) script_path="$link_dir/$link_target" ;;
	esac
done
here=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
exec node "$here/dist/cli.js" "$@"
