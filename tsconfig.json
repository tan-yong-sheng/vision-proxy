{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2023"],
		"types": ["node"],
		"strict": true,
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": false,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"resolveJsonModule": true
	},
	"include": ["src/**/*.ts", "lib/**/*.ts", "extensions/**/*.ts"],
	"exclude": ["lib/**/*.test.ts", "lib/**/__tests__/**", "extensions/**/*.test.ts", "extensions/**/__tests__/**"]
}
